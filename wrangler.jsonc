{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whoami",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}